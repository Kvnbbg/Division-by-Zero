<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>
  <groupId>fr.kvnbbg</groupId>
  <artifactId>tdaah-agent</artifactId>
  <version>0.2.0</version>
  <name>TDAAH Agent</name>
  <description>Measurement agent and batch data pipeline. Kevin Marville / Tech &amp; Stream.</description>
  <!-- L'artefact produit ne portait aucune licence : quiconque le récupérait
       n'avait aucun droit d'usage écrit, car le fichier LICENSE du dépôt ne
       suit pas le .jar. Apache-2.0, comme LICENSE et comme la documentation —
       une licence déclarée différemment selon l'endroit vaut moins que pas de
       licence du tout, parce qu'elle donne l'illusion d'une réponse. -->
  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Kevin Marville</name>
      <organization>Tech &amp; Stream</organization>
      <organizationUrl>https://techandstream.com</organizationUrl>
    </developer>
  </developers>

  <properties>
    <java.version>21</java.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
